{
  "expo": {
    "name": "Moments",
    "slug": "homescreen-notifiers",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "homescreennotifiers",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.sarfrazalam.homescreennotifiers",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF9466",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Partner ko photo bhejne ke liye gallery access chahiye.",
          "cameraPermission": "Partner ko photo bhejne ke liye camera access chahiye."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Partner ko photo bhejne ke liye camera access chahiye.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-foreground.png",
          "color": "#FF9466"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "MomentWidget",
              "label": "Moments",
              "minWidth": "160dp",
              "minHeight": "160dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "description": "Latest photo or note from your person",
              "previewImage": "./assets/images/icon.png",
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            },
            {
              "name": "AddMomentWidget",
              "label": "Send a Moment",
              "minWidth": "80dp",
              "minHeight": "80dp",
              "targetCellWidth": 1,
              "targetCellHeight": 1,
              "description": "One tap to send your person a photo or note",
              "previewImage": "./assets/images/icon.png",
              "resizeMode": "none"
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b7b37943-fd5c-425d-bac0-728fbe8eb90c"
      }
    }
  }
}
